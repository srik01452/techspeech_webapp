<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TecSpeech</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
<h1>TecSpeech</h1>
<p>Convert Tamil Text & PDF into Natural Tamil Audio</p>
</header>

<section class="container">

<textarea id="textInput"
placeholder="Enter Tamil text here..."></textarea>

<input type="file" accept=".pdf">

<button onclick="convertSpeech()">
Convert to Speech
</button>

<audio id="audioPlayer" controls></audio>

</section>

<script src="script.js"></script>
</body>
</html>body{
font-family:Arial,sans-serif;
background:#f5f5f5;
margin:0;
padding:0;
}

header{
background:#0d6efd;
color:white;
text-align:center;
padding:30px;
}

.container{
max-width:800px;
margin:auto;
padding:20px;
}

textarea{
width:100%;
height:200px;
padding:10px;
font-size:16px;
}

button{
margin-top:15px;
padding:12px 25px;
background:#0d6efd;
color:white;
border:none;
cursor:pointer;
border-radius:8px;
}

audio{
margin-top:20px;
width:100%;
}
function convertSpeech(){

const text =
document.getElementById("textInput").value;

const speech =
new SpeechSynthesisUtterance(text);

speech.lang = "ta-IN";

speechSynthesis.speak(speech);

}

